{
  "name": "reel",
  "private": false,
  "type": "module",
  "scripts": {
    "start": "bun run server/server.ts",
    "dev": "concurrently -n server,web -c yellow,cyan \"bun run server/server.ts\" \"vite --host\"",
    "dev:web": "vite",
    "test": "bun test server/test && vitest run",
    "check": "tsc --noEmit && tsc --noEmit -p web",
    "build": "tsc --noEmit -p web && vite build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,css,html,json,md}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@formkit/auto-animate": "^0.10.0",
    "@tanstack/react-query": "^5.102.0",
    "@tanstack/react-virtual": "^3.14.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "hono": "^4.6.0",
    "lucide-react": "^1.42.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.1.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "shadcn": "^4.21.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "lint-staged": "^17.5.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
